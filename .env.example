DATABASE_URL=postgresql://user:password@localhost:5432/fintrack?schema=public
JWT_SECRET=fintrack-dev-secret

# Set to "true" to show the "Login Admin / Demo User" quick-login
# buttons on /login. Keep it off (or unset) in production.
NEXT_PUBLIC_ENABLE_DEMO_LOGIN=true

# Subscription checkout stays closed until price, terms, and merchant gateway are ready.
SUBSCRIPTIONS_ENABLED=false
# QRIS Gateway deploys separately: https://github.com/afarisulhaq/qris-gateway
# (integration guide: docs/integrasi-website.md in that repo). Point QRIS_BASE_URL
# at the gateway origin; production must be HTTPS.
QRIS_BASE_URL=http://127.0.0.1:3100
QRIS_API_KEY=
# sandbox or production; must match the environment of QRIS_API_KEY
QRIS_ENVIRONMENT=sandbox
# gopay or shopeepay; may stay empty when the wallet sets the provider
QRIS_PROVIDER=
# Required with QRIS_ENVIRONMENT=production: managed wallet from GET /v1/connections
QRIS_CONNECTION_ID=
# Comma-separated webhook secrets from the gateway dashboard. Optional:
# payment checks still run through POST /v1/invoices/:id/check without them.
QRIS_WEBHOOK_SECRETS=
# Encrypts each user's Split Bills QRIS API key at rest. Use 32 random bytes
# encoded as base64 or 64 hexadecimal characters; keep it stable across deploys.
QRIS_SETTINGS_ENCRYPTION_KEY=
SUBSCRIPTION_PLAN_NAME=
SUBSCRIPTION_PRICE_IDR=
SUBSCRIPTION_DURATION_DAYS=
